# MovieMemo Agent Configuration
# AI-powered movie scene Q&A agent with x402 micropayments

# ============================================
# AGENT IDENTITY
# ============================================
AGENT_NAME=MovieMemo
AGENT_DESCRIPTION=AI agent for movie scene Q&A - OST, locations, easter eggs, and trivia
AGENT_VERSION=0.1.0

# ============================================
# HTTP SERVER CONFIGURATION
# ============================================
# Port that Bun will listen on locally
PORT=8787
# Base URL surfaced in the agent manifest for absolute links
API_BASE_URL=http://localhost:8787

# ============================================
# BLOCKCHAIN & PAYMENTS (x402 on Base)
# ============================================
# Payment network - using Base for USDC payments
PAYMENTS_NETWORK=base
# Facilitator API base URL for x402 payments
PAYMENTS_FACILITATOR_URL=https://facilitator.daydreams.systems
# RPC endpoint for Base network
RPC_URL=https://mainnet.base.org
# Auto-register agent identity at startup
REGISTER_IDENTITY=false

# Address that receives x402 payments (USDC on Base)
PAYMENTS_RECEIVABLE_ADDRESS=
# Default price in USDC (0.01 = 1 cent)
DEFAULT_PRICE=0.01

# ============================================
# WALLET SECRETS
# ============================================
# Required: Private key for agent wallet (used to sign payment requests)
# Generate with: openssl rand -hex 32
PRIVATE_KEY=

# ============================================
# LLM API KEYS
# ============================================
# OpenAI API Key (for GPT models)
OPENAI_API_KEY=

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=

# ============================================
# OPTIONAL: MOVIE DATA APIs
# ============================================
# The Movie Database (TMDB) API Key
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OMDb API Key (alternative movie database)
# Get yours at: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=